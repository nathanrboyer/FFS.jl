# ╔═╡ edfa4306-499d-47a8-89ea-d0aabe81e318
"""Removes the function argument list from the latex equation,
so equations are shorter and better match the source text."""
function remove_arguments(s::LaTeXString)
    r = r"\\left\(.*?\\right\)"
    return LaTeXString(replace(s, r=>"", count=1))
end

# ╔═╡ c428942d-c2d3-4844-9249-a22f4512ad3a
remove_arguments(@latexrun σ_ref(P_b, U, Z, P_meq, α) =
	(P_b + (P_b ^ 2 + 9 * (U * Z * P_meq * (1 - α) ^ 2) ^ 2) ^ 0.5) /
(3 * (1 - α) ^ 2)
				)

# ╔═╡ b96d90f2-265c-4877-acdd-ec236f721bab
remove_arguments(@latexrun σ_ml(p, R_i, R_o, F, P_m) =
	(p * R_i ^ 2) / (R_o ^ 2 - R_i ^ 2) + F /
(π * (R_o ^ 2 - R_i ^ 2)) + P_m
				)

# ╔═╡ 1af837d7-9e77-444d-99b8-7837515d7d7d
remove_arguments(@latexrun σmc(p, R_i, t) = (p * R_i) / t )

# ╔═╡ eaf5f0eb-88d2-4da8-a46c-42ac7c404c3b
remove_arguments(@latexrun Pmeq(σ_mc, σ_ml) =
	(((σ_mc - σ_ml) ^ 2 + σ_mc ^ 2 + σ_ml ^ 2) / 2) ^ 0.5
				)

# ╔═╡ e03049c4-62f0-4f1f-84b8-112c10152c9d
remove_arguments(@latexrun Z(ψ, x, θ, τ) = 
	((2 * ψ) / π - (x * θ) / π * ((2 - 2 * τ + x * τ) / (2 - τ))) ^ -1
				)

# ╔═╡ f6068e00-7753-471b-8ef0-ba004e8d5d42
remove_arguments(@latexrun ψ(A, θ) = acos(A * sin(θ)) )

# ╔═╡ 267e31ca-98d4-4696-b516-9cd18967c939
remove_arguments(@latexrun α(a, t, c) =
	(a / t) / (1 + t / c)
				)

# ╔═╡ bbb04c05-89ae-4ec7-8b28-09cf025ae22c
remove_arguments(@latexrun A(x, τ) = 
	x * (((1 - τ) * (2 - 2 * τ + x * τ) + (1 - τ + x * τ)^ 2) /
(2 * (1 + (2 - τ) * (1 - τ))))
				)

# ╔═╡ 71027104-d3a4-4077-a2c4-f75f6768c3b8
remove_arguments(@latexrun τ(t, R_o) = t / R_o )

# ╔═╡ e6bc1c06-e81e-4788-beed-fcac54f74f94
remove_arguments(@latexrun x(a, t) = a / t )

# ╔═╡ f5293391-4afa-43a1-9f98-1df3d8f61442
remove_arguments(@latexrun θ_in(c, R_i) = 
	(π * c) / (4 * R_i)
				)

# ╔═╡ eca05908-55dc-4415-9b36-66875713c163
remove_arguments(@latexrun θ_ex(c, R_o) =
	(π * c) / (4 * R_o)
				)

# ╔═╡ 791ae8ea-74b9-48e6-a25b-353cd2325518
remove_arguments(@latexrun U_2_20(a_t, Ri_t) =
	1.3068 - 0.495 * a_t + (0.055 * a_t - 0.026) * Ri_t
				)

# ╔═╡ aef39dc0-9c14-49dd-9b0e-8a9c8fd0fc23
remove_arguments(@latexrun U_1(a_t) =
	1.601 - 0.55 * a_t
				)

