# ╔═╡ edfa4306-499d-47a8-89ea-d0aabe81e318
"""Removes the function argument list from the latex equation,
so equations are shorter and better match the source text."""
function remove_arguments(s::LaTeXString)
    r = r"\\left\(.*?\\right\)"
    return LaTeXString(replace(s, r=>"", count=1))
end

# ╔═╡ d6dfdc7a-6b04-4978-8124-953b328dbf37
remove_arguments(@latexrun σ_ref(P_b, P_m, α) =
	(P_b + (P_b ^ 2 + 9 * P_m ^ 2) ^ 0.5) / (3 * (1 - α))
				)

# ╔═╡ 7883b00f-b6cc-4b2f-b770-d0b1eb76885a
remove_arguments(@latexrun α(c, W) = c / W )

# ╔═╡ 04a6b9ea-5fd0-4113-abca-94dee7fc2deb
remove_arguments(@latexrun P_m(P_0, P_1, P_2, P_3, P_4) =
	P_0 + P_1 / 2 + P_2 / 3 + P_3 / 4 + P_4 / 5
				)

# ╔═╡ 3af7c530-01fc-4bc8-b004-be39880bb7aa
remove_arguments(@latexrun P_b(P_0, P_1, P_2, P_3, P_4) =
	- P_1 / 2 - P_2 / 2 - 9 * P_3 / 20 - 6 * P_4 / 15
				)

