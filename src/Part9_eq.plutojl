# ╔═╡ edfa4306-499d-47a8-89ea-d0aabe81e318
"""Removes the function argument list from the latex equation,
so equations are shorter and better match the source text."""
function remove_arguments(s::LaTeXString)
    r = r"\\left\(.*?\\right\)"
    return LaTeXString(replace(s, r=>"", count=1))
end

# ╔═╡ b93dd582-b71f-47b2-b3f8-5cce7d1e70a1
remove_arguments(@latexrun σ_f(σ_ys, σ_uts) = 
	(σ_ys + σ_uts) / 2 
				)

# ╔═╡ 204f7476-3d0f-4f72-aa97-efb212a2e5ff
remove_arguments(@latexrun Lpr_max(σ_f, σ_ys) = 
	σ_f / σ_ys
				)

# ╔═╡ 6645b103-3784-4ff5-98d7-27d1d2b40ff6
remove_arguments(@latexrun Kr_max(Lpr) = 
	(1 - 0.14 * Lpr ^ 2) * (0.3 + 0.7 * exp(-0.65 * Lpr ^ 6))
				)

# ╔═╡ 558df121-8c83-4687-aaba-85e7950f93a4
remove_arguments(@latexrun L_r(σ_ref, σ_ys) = 
	σ_ref / σ_ys
				)

# ╔═╡ 101093f0-6700-4009-9f43-d6224e1a86a2
remove_arguments(@latexrun J_1mm(CVN) = 
	4.482 * CVN ^ 1.28
				)

# ╔═╡ 8ca78a3c-f750-475a-ba51-fed39d4d9ae3
remove_arguments(@latexrun K_mat(J_crit, E_t, ν) = 
	((J_crit * (E_t * 1e6)) / (1 - ν ^ 2)) ^ 0.5 / 1000
				)

# ╔═╡ 430a96c3-f372-4930-8aa8-b491916cf732
remove_arguments(@latexrun Φ_0(a_eff, a) = 
	(a_eff / a) ^ 0.5
				)

# ╔═╡ 7003f1fa-d58e-4e53-bad6-9e1f5922765a
remove_arguments(@latexrun a_eff(a, K_sri, σ_ys) = 
	a + (1 / (2 * pi)) * (K_sri / σ_ys) ^ 2
				)

# ╔═╡ 902bbcc9-2e29-43ab-aadc-e3293310bc29
remove_arguments(@latexrun K_srj(Φ_0, K_sri) = 
	Φ_0 * K_sri
				)

# ╔═╡ 9ecec921-339f-4549-aadb-49beb2ffae3a
remove_arguments(@latexrun X(K_srj, Lpr, Kpi) = 
	K_srj * (Lpr / Kpi)
				)

