# ╔═╡ edfa4306-499d-47a8-89ea-d0aabe81e318
"""Removes the function argument list from the latex equation,
so equations are shorter and better match the source text."""
function remove_arguments(s::LaTeXString)
    r = r"\\left\(.*?\\right\)"
    return LaTeXString(replace(s, r=>"", count=1))
end

# ╔═╡ 8692fc7c-2b58-4afb-adea-7fb009bc2e3f
remove_arguments(@latexrun σ_ref(P_b, U, Σ_m, α) =
	(P_b + (P_b ^ 2 + 9 * (U * Σ_m * (1 - α) ^ 2) ^ 2) ^ 0.5) /
(3 * (1 - α) ^ 2)
				)

# ╔═╡ d60f85f9-9074-4c9a-aa4c-df9bfb5c5488
remove_arguments(@latexrun P_m(P_0, P_1, P_2, P_3, P_4) =
	P_0 + P_1 / 2 + P_2 / 3 + P_3 / 4 + P_4 / 5
				)

# ╔═╡ b02445cd-10c3-405a-bbfe-735da48fc2bc
remove_arguments(@latexrun P_b(P_0, P_1, P_2, P_, P_4) =
	- P_1 / 2 - P_2 / 2 - 9 * P_3 / 20 - 6 * P_4 / 15
				)

# ╔═╡ d78af4ef-e1c9-4855-81a2-48c2575631a4
remove_arguments(LaTeXString(replace(replace((@latexrun U(a_t, Ri_t) =
	1.3807 - 0.2978 * a_t + (0.003 * a_t - 0.0154) * Ri_t
				),
					 "a_{t}" => raw"\frac{a}{t}"),
					 "Ri_{t}" => raw"\frac{R_i}{t}")))

# ╔═╡ fe95a378-bfe8-4ff7-85c4-69100f7f6e0e
remove_arguments(@latexrun Σ_m(σ_mc, Z, P_m) =
	sqrt(((σ_mc - Z * P_m) ^ 2 + σ_mc ^ 2 + (Z * P_m) ^ 2) / 2)
				)

# ╔═╡ a595885c-f2af-4b4f-962a-36d7219c92bc
remove_arguments(@latexrun Z(α, τ) =
	(1 - α * ((2 - 2 * τ + α * τ) / (2 - τ))) ^ -1
				)

# ╔═╡ 95c3f333-91e3-43c9-9377-cd0d9a32be93
remove_arguments(@latexrun τ(t, R_o) = t / R_o )

# ╔═╡ 83b0abf8-2281-40da-b9df-d33966d34766
remove_arguments(@latexrun α(a, t) = a / t )

# ╔═╡ 95dea4e9-7241-4034-bc60-c640e7bd6e1b
remove_arguments(@latexrun σ_mc_in(p, R_i, t) = p * R_i / t )

