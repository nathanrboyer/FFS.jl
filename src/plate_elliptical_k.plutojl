# ╔═╡ edfa4306-499d-47a8-89ea-d0aabe81e318
"""Removes the function argument list from the latex equation,
so equations are shorter and better match the source text."""
function remove_arguments(s::LaTeXString)
    r = r"\\left\(.*?\\right\)"
    return LaTeXString(replace(s, r=>"", count=1))
end

# ╔═╡ 8acc08da-f932-4e67-b75c-755832bc8082
remove_arguments(@latexrun h_90(x, a, M_1, M_2, M_3) =
    (2 / sqrt(2 * π * (a - x))) *
    (1 + M_1 * (1 - x / a) ^ 0.5 + M_2 * (1 - x / a) + M_3 * (1 - x / a) ^ 1.5)
                )

# ╔═╡ c9ea3314-2a7f-422f-ae9a-d025ada35cb8
remove_arguments(LaTeXString(replace((@latexrun function Q(a_c)
    if a_c ≤ 1
        return 1 + 1.464 * a_c ^ 1.65
    elseif a_c > 1
        return 1 + 1.464 * (1 / a_c) ^ 1.65
    end
end
                ), "a_{c}" => "(a/c)")))

# ╔═╡ 004eed74-9755-441d-9947-01673346a42f
remove_arguments(@latexrun M_1(Q, Y_0, Y_1) =
	(π / sqrt(2 * Q)) * (4 * Y_0 - 6 * Y_1) - 24 / 5
				)

# ╔═╡ 15ef38de-b8f3-43cc-95a3-b2a5a79bd7b0
remove_arguments(@latexrun M_3(Q, Y_0, M_1) =
	2 * ((π / sqrt(2 * Q) ) * Y_0 - M_1 - 4)
				)

# ╔═╡ 4970f254-fdda-4862-98d1-c300d427dab0
remove_arguments(@latexrun Y_0(B_0, B_1, B_2, a, t) =
	B_0 + B_1 * (a / t) ^ 2 + B_2 * (a / t) ^ 4
				)

# ╔═╡ 383e8a32-194c-47a2-b996-331c6454487a
remove_arguments(@latexrun B_0(a, c) =
	1.10190 - 0.019863 * (a / c) - 0.043588 * (a / c) ^ 2
				)

# ╔═╡ 1dbe334b-18e1-44f3-91bd-671cc57f8f15
remove_arguments(@latexrun B_1(a, c) =
	4.32489 - 14.9372 * (a / c) + 19.4389 * (a / c) ^ 2 - 8.52318 * (a / c) ^ 3
				)

# ╔═╡ 4d9e426b-c46a-4983-8ecf-3e969f3f4e93
remove_arguments(@latexrun B_2(a, c) =
	-3.03329 + 9.96083 * (a / c) - 12.582 * (a / c) ^ 2 + 5.52318 * (a / c) ^ 3
				)

# ╔═╡ 1ecfa04f-8295-4ed3-9ac0-4b17ea7dd940
remove_arguments(@latexrun Y_1(A_0, A_1, A_2, a, t) =
	A_0 + A_1 * (a / t) ^ 2 + A_2 * (a / t) ^ 4
				)

# ╔═╡ 3ebbc5c3-9a4a-41b5-97cc-068da7e9d7cf
remove_arguments(@latexrun A_0(a, c) =
	0.456128 - 0.114206 * (a / c) - 0.046523 * (a / c) ^ 2
				)

# ╔═╡ f1acdfed-f3a1-453f-8b20-f98f3ba9a3d0
remove_arguments(@latexrun A_1(a, c) =
	3.022 - 10.8679 * (a / c) + 14.94 * (a / c) ^ 2 - 6.8537 * (a / c) ^ 3
				)

# ╔═╡ 2ec43da6-c6e7-4f4c-b3da-5f70b5661f5f
remove_arguments(@latexrun A_2(a, c) =
	-2.28655 + 7.88771 * (a / c) - 11.0675 * (a / c) ^ 2 + 5.16354 * (a / c) ^ 3
				)

# ╔═╡ bcb9fbce-3fb7-4a70-93d8-3575e16900fb
remove_arguments(@latexrun h_0(x, a, N_1, N_2, N_3) =
    (2 / sqrt(π * x) ) *
    (1 + N_1 * (x / a) ^ 0.5 + N_2 * (x / a) + N_3 * (x / a) ^ 1.5)
                )

# ╔═╡ 0ccbd96d-d1ac-4f1d-b1cf-4bfadf86f031
remove_arguments(@latexrun N_1(Q, F_0, F_1) =
	(π / sqrt(4 * Q)) * (30 * F_1 - 18 * F_0) - 8
				)

# ╔═╡ c53d6bf9-aba4-477d-9303-3b6af0201908
remove_arguments(@latexrun N_2(Q, F_0, F_1) =
	(π / sqrt(4 * Q)) * (60 * F_0 - 90 * F_1) + 15
				)

# ╔═╡ 184fb8ea-f64e-46fd-a5ba-ff1cf9e64472
remove_arguments(@latexrun N_3(N_1, N_2) =
	-(1 + N_1 + N_2)
				)

# ╔═╡ 30cea32c-49fc-4ac9-b622-ad48ffbac40a
remove_arguments(@latexrun F_0(α, a, c, β) =
	α * (a / c) ^ β
				)

# ╔═╡ d8b3c122-f90d-4d7a-a2d7-956d54b10095
remove_arguments(@latexrun α(a, t) =
	1.14326 + 0.0175996 * (a / t) + 0.501001 * (a / t) ^ 2
				)

# ╔═╡ aaec0ae4-5de6-4164-a407-850304c8d974
remove_arguments(@latexrun β(a, t) =
	0.458320 - 0.102985 * (a / t) - 0.398175 * (a / t) ^2
				)

# ╔═╡ ec94a1b2-a758-467a-b373-5e72944f9e83
remove_arguments(@latexrun F_1(γ, a, c, δ) =
	γ * (a / c) ^ δ
				)

# ╔═╡ b23dde98-a2ec-4c08-8660-6d48187f53a8
remove_arguments(@latexrun γ(a, t) =
	0.976770 - 0.131975 * (a / t) - 0.484875 * (a / t) ^ 2
				)

# ╔═╡ 9970203a-263a-4834-8583-afbe6adeaa83
remove_arguments(@latexrun δ(a, t) =
	0.448863 - 0.173295 * (a / t) - 0.267775 * (a / t) ^ 2
				)

# ╔═╡ 71e71733-3afe-4054-96e2-d1efff3df0ef
remove_arguments(@latexrun fw(c, W, a, t) =
	(sec( (π * c / (2 * W)) * sqrt(a / t) ) ) ^ 0.5
				)

