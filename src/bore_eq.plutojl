# ╔═╡ edfa4306-499d-47a8-89ea-d0aabe81e318
"""Removes the function argument list from the latex equation,
so equations are shorter and better match the source text."""
function remove_arguments(s::LaTeXString)
    r = r"\\left\(.*?\\right\)"
    return LaTeXString(replace(s, r=>"", count=1))
end

# ╔═╡ f429726b-089a-4b3e-9fda-8e40dc92daed
remove_arguments(@latexrun P_b_internal(p) = p / 2)

# ╔═╡ ed838028-4a91-41c8-899c-fb10a8a1974b
remove_arguments(@latexrun P_b_external(p) = -p / 2)

# ╔═╡ 738c3483-5b3c-4205-9f66-c7635d5172e0
remove_arguments(@latexrun P_m(p, R_i, t) = p * R_i / t)

# ╔═╡ 6500929b-363a-4182-a9dd-91e3a2f91333
remove_arguments(@latexrun α(a, t, c) =  (a / t) / (1 + t / c) )

# ╔═╡ 015d037c-3dcb-497b-a114-473c9e668a60
remove_arguments(@latexrun g(a, c, α) = 1 - (20 * (a / (2 * c)) ^0.75) * α ^3 )

# ╔═╡ ff781a8b-48f0-4cb0-81f8-c9dd2bf98c27
remove_arguments(@latexrun λ_a(c, R_i, a) = 1.818 * c / (sqrt(R_i * a)) )

# ╔═╡ eaf80d6a-1169-4611-845b-c66239f38260
remove_arguments(@latexrun M_t(λ_a) =
    ((1.02 + 0.4411 * λ_a ^ 2 + 0.006124 * λ_a ^ 4) /
    (1.0 + 0.02642 * λ_a ^ 2.0 + 1.533 * 10 ^ -6 * λ_a ^ 4)) ^ 0.5 
                )

# ╔═╡ 8b88e0b5-3ae5-4e51-a3b0-024ed9d2cd8f
remove_arguments(LaTeXString(replace((@latexrun M_s(a_t, M_t) =
	1.0 / (1 - a_t + a_t * (1 / M_t) ) ), "a_{t}" => raw"\frac{a}{t}")))

# ╔═╡ 5613321a-e9ff-408b-bd09-f969ef3796f2
remove_arguments(@latexrun σ_ref(g, P_b, M_s, P_m, α) =
	(g * P_b + ( (g * P_b) ^ 2 +
9 *(M_s * P_m * (1 - α) ^ 2) ^ 2) ^ 0.5 ) / (3 * (1 - α) ^ 2)
				)

