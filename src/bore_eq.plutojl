# ╔═╡ d9e0d950-7c9c-11f1-9f8f-3b8538eebdbf
md"""
### Verification
These equations last verified to API 579-1/ASME FFS-1 2021 Edition and ASME BPVC 2025 Edition.
- *Verified compatible with BPVC 2025 Edition: Maxwell Frame -- 07/13/2026*
"""

# ╔═╡ 1545fde5-5475-4194-8fbe-12c9dcb54cc5
md"# RCSCLE3 Equations
#### Reference stress
- Cylinder
- Surface crack
- Longitudinal direction
- Semi-ellipitical shape
- Through-wall arbitrary stress distribution"

# ╔═╡ f429726b-089a-4b3e-9fda-8e40dc92daed
"""9C.5.10.2(b) - equation(9C.49), Bending Stress, for internal crack in bore"""
Pb_internal(p) = p / 2

# ╔═╡ ed838028-4a91-41c8-899c-fb10a8a1974b
"""9C.5.10.2(b) - equation(9C.50), Bending Stress, for external crack in bore"""
Pb_external(p) = -p / 2

# ╔═╡ 738c3483-5b3c-4205-9f66-c7635d5172e0
"""9C.5.10.2(b) - equation(9C.48), Membrane Stress, for internal and external cracks in bores with
internal pressure, uses support OD"""
Pm(p, Ri, t) = p * Ri / t 

# ╔═╡ 6500929b-363a-4182-a9dd-91e3a2f91333
"""equation(9c.86) crack depth parameter, unique to inner shell with support"""
α(a, t, c) =  (a / t) / (1 + t / c)

# ╔═╡ 015d037c-3dcb-497b-a114-473c9e668a60
"""equation(9C.32), reference stress parameter, 9C.5.10.1 eq(9C.85) requires α be defined in
eq(9C.86)"""
g(a, c, α) = 1 - (20 * (a / (2 * c)) ^0.75) * α ^3

# ╔═╡ ff781a8b-48f0-4cb0-81f8-c9dd2bf98c27
"""equation(9C.19) shell parameter"""
λa(c, Ri, a) = 1.818 * c / ((Ri * a) ^ 0.5)

# ╔═╡ eaf80d6a-1169-4611-845b-c66239f38260
"""equation(9C.8) correction factor, 9C.2.3.3 λa substitution"""
Mt(λa) = ((1.02 + 0.4411 * λa ^ 2 + 0.006124 * λa ^ 4) /
    (1.0 + 0.02642 * λa ^ 2.0 + 1.533 * 10 ^ -6 * λa ^ 4)) ^ 0.5

# ╔═╡ 8b88e0b5-3ae5-4e51-a3b0-024ed9d2cd8f
"""equation(9C.18) surface correction factor"""
Ms(a_t, Mt) = 1.0 / (1 - a_t + a_t / Mt)

# ╔═╡ 5613321a-e9ff-408b-bd09-f969ef3796f2
"""equation(9C.85) Reference Stress"""
σref(g, Pb, Ms, Pm, α) = (g * Pb + ( (g * Pb) ^ 2 +
9 *(Ms * Pm * (1 - α) ^ 2) ^ 2) ^ 0.5 ) / (3 * (1 - α) ^ 2)

# ╔═╡ 70ca7500-e151-4692-9f2d-769495deca6c
md"# Appendix"

# ╔═╡ edfa4306-499d-47a8-89ea-d0aabe81e318
"""Removes the function argument list from the latex equation,
so equations are shorter and better match the source text."""
function remove_arguments(s::LaTeXString)
    r = r"\\left\(.*?\\right\)"
    return LaTeXString(replace(s, r=>"", count=1))
end

